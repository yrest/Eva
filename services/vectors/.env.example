# Vector Service Configuration

# Service
SERVICE_PORT=8007
SERVICE_HOST=0.0.0.0

# Authentication - CHANGE THESE!
VECTOR_QUERY_TOKEN=your-secure-query-token-here
VECTOR_UPDATE_TOKEN=your-secure-update-token-here

# Qdrant connection
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional if Qdrant has auth

# Default collection settings
DEFAULT_VECTOR_SIZE=384  # nomic-embed-text dimensions
DEFAULT_DISTANCE=Cosine  # Cosine, Euclid, Dot

# Rate limiting
RATE_LIMIT_QUERIES_PER_MIN=1000
RATE_LIMIT_UPDATES_PER_MIN=100

# Logging
AUDIT_LOG_PATH=./logs/vectors_audit.jsonl
LOG_LEVEL=INFO

# For distributed setup (Qdrant on separate Mac):
# QDRANT_URL=http://192.168.1.100:6333
