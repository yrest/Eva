# Filesystem Service Configuration

# Server
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8005

# Security - CHANGE THESE IN PRODUCTION!
READ_TOKEN=eva_read_token_change_me
WRITE_TOKEN=eva_write_token_change_me
JWT_SECRET=your-secret-key-change-me

# File Access Control
ALLOWED_PATHS=/home/user/documents,/home/user/workspace
MAX_FILE_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=60

# Storage
SQLITE_DB_PATH=./data/filesystem.db
AUDIT_LOG_PATH=./data/audit.log

# Future: Qdrant Integration (not yet implemented)
QDRANT_HOST=localhost
QDRANT_PORT=6333
ENABLE_VECTOR_INDEX=false
