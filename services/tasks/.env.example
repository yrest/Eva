# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8008

# Authentication
TASKS_READ_TOKEN=change-me-secure-read-token
TASKS_WRITE_TOKEN=change-me-secure-write-token
TASKS_ADMIN_TOKEN=change-me-secure-admin-token

# Database
DATABASE_URL=postgresql://eva:eva@localhost:5432/eva

# Redis Queue
REDIS_URL=redis://localhost:6379
TASK_QUEUE_NAME=eva:tasks
MAX_WORKERS=4

# LLM Backends (OpenAI-compatible)
DEFAULT_LLM_BACKEND=lmstudio

# LM Studio (local)
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_API_KEY=lm-studio
DEFAULT_LMSTUDIO_MODEL=mistral-7b-instruct

# OpenAI
OPENAI_API_KEY=sk-...
DEFAULT_OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Tool Sandboxing
DOCKER_ENABLED=true
DOCKER_NETWORK=none
DOCKER_CPU_LIMIT=1.0
DOCKER_MEMORY_LIMIT=512m
DOCKER_TIMEOUT=60
SANDBOX_IMAGE=python:3.11-slim

# Data Retention
HOT_STORAGE_DAYS=90
COLD_STORAGE_DAYS=180
ARCHIVE_ENABLED=true
ARCHIVE_SCHEDULE_CRON=0 2 * * *

# Services Integration
MEMORY_SERVICE_URL=http://localhost:8004
VECTOR_SERVICE_URL=http://localhost:8007
VECTOR_QUERY_TOKEN=change-me-secure-query-token
FILESYSTEM_SERVICE_URL=http://localhost:8005
FILESYSTEM_READ_TOKEN=change-me-secure-read-token

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/tasks_audit.jsonl

# Rate Limiting
RATE_LIMIT_PER_MIN=100
