# Embedding Service Configuration

# Service
SERVICE_PORT=8006
SERVICE_HOST=0.0.0.0

# Authentication - CHANGE THESE!
EMBED_TOKEN=your-secure-embed-token-here

# Embedding Backends
DEFAULT_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234

# Default Models
DEFAULT_OLLAMA_MODEL=nomic-embed-text
DEFAULT_LMSTUDIO_MODEL=text-embedding-nomic-embed-text-v1.5

# Chunking
DEFAULT_CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_TEXT_LENGTH=100000

# Logging
AUDIT_LOG_PATH=./logs/embeddings_audit.jsonl
LOG_LEVEL=INFO

# For distributed setup (embedding service on separate Mac):
# OLLAMA_URL=http://192.168.1.100:11434
# LMSTUDIO_URL=http://192.168.1.100:1234
