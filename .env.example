# Application
NODE_ENV=development

# Database
DATABASE_URL=postgresql://eva:eva@localhost:5432/eva
POSTGRES_USER=eva
POSTGRES_PASSWORD=eva
POSTGRES_DB=eva

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-secret-key-change-in-production

# AI
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Vector Database (Legacy - for knowledge service)
VECTOR_DB_URL=http://localhost:6333

# ========================================
# Filesystem Service (Port 8005)
# ========================================
FILESYSTEM_READ_TOKEN=change-me-secure-read-token
FILESYSTEM_WRITE_TOKEN=change-me-secure-write-token
FILESYSTEM_ALLOWED_PATHS=/home/user,/data

# ========================================
# Embedding Service (Port 8006)
# ========================================
EMBED_TOKEN=change-me-secure-embed-token

# Embedding backends (local)
DEFAULT_EMBEDDING_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234

# Default models
DEFAULT_OLLAMA_MODEL=nomic-embed-text
DEFAULT_LMSTUDIO_MODEL=text-embedding-nomic-embed-text-v1.5

# ========================================
# Vector Service (Port 8007)
# ========================================
VECTOR_QUERY_TOKEN=change-me-secure-query-token
VECTOR_UPDATE_TOKEN=change-me-secure-update-token

# Qdrant connection
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional

# ========================================
# Distributed Setup (Optional)
# ========================================
# If running embedding/vector services on separate hardware:
# OLLAMA_URL=http://192.168.1.100:11434
# LMSTUDIO_URL=http://192.168.1.100:1234
# QDRANT_URL=http://192.168.1.101:6333
